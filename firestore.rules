rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // כל משתמש יכול לקרוא ולכתוב רק את הנתונים של עצמו
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /transactions/{txId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.date is string && request.resource.data.date.size() == 10
          && request.resource.data.description is string && request.resource.data.description.size() <= 100
          && request.resource.data.category is string && request.resource.data.category.size() <= 40
          && (!('time' in request.resource.data) || (request.resource.data.time is string && request.resource.data.time.size() == 5));
      }
    }
  }
}
